{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "factoryName": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "sqlServerName": {
      "type": "string",
      "defaultValue": "haas-govdata-westus"
    },
    "sqlDatabaseName": {
      "type": "string",
      "defaultValue": "govdata"
    }
  },
  "resources": [
    {
      "type": "Microsoft.DataFactory/factories",
      "apiVersion": "2018-06-01",
      "name": "[parameters('factoryName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.DataFactory/factories/linkedservices",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/LS_Socrata')]",
      "properties": {
        "type": "RestService",
        "parameters": {
          "baseUrl": {
            "type": "String"
          }
        },
        "typeProperties": {
          "url": "@{linkedService().baseUrl}",
          "authenticationType": "Anonymous",
          "enableServerCertificateValidation": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('factoryName'))]"
      ]
    },
    {
      "type": "Microsoft.DataFactory/factories/linkedservices",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/LS_AzureSql')]",
      "properties": {
        "type": "AzureSqlDatabase",
        "typeProperties": {
          "connectionString": "[concat('Data Source=tcp:', parameters('sqlServerName'), '.database.windows.net,1433;Initial Catalog=', parameters('sqlDatabaseName'), ';Encrypt=True;Connection Timeout=60')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('factoryName'))]"
      ]
    },
    {
      "type": "Microsoft.DataFactory/factories/datasets",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/DS_SocrataJson')]",
      "properties": {
        "type": "RestResource",
        "linkedServiceName": {
          "referenceName": "LS_Socrata",
          "type": "LinkedServiceReference",
          "parameters": {
            "baseUrl": "@dataset().baseUrl"
          }
        },
        "parameters": {
          "baseUrl": {
            "type": "String"
          },
          "relativeUrl": {
            "type": "String"
          }
        },
        "typeProperties": {
          "relativeUrl": {
            "value": "@dataset().relativeUrl",
            "type": "Expression"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('factoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/linkedservices', parameters('factoryName'), 'LS_Socrata')]"
      ]
    },
    {
      "type": "Microsoft.DataFactory/factories/datasets",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/DS_SqlTable')]",
      "properties": {
        "type": "AzureSqlTable",
        "linkedServiceName": {
          "referenceName": "LS_AzureSql",
          "type": "LinkedServiceReference"
        },
        "parameters": {
          "schemaName": {
            "type": "String",
            "defaultValue": "gov"
          },
          "tableName": {
            "type": "String"
          }
        },
        "typeProperties": {
          "schema": {
            "value": "@dataset().schemaName",
            "type": "Expression"
          },
          "table": {
            "value": "@dataset().tableName",
            "type": "Expression"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('factoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/linkedservices', parameters('factoryName'), 'LS_AzureSql')]"
      ]
    },
    {
      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/PL_LoadSource')]",
      "properties": {
        "description": "Load one Socrata source: count rows changed since the watermark, copy them page by page ($offset loop, 50k rows) into gov.stg_<source>, then MERGE into gov.raw_<source>.",
        "parameters": {
          "source": {
            "type": "Object"
          },
          "fullReload": {
            "type": "Bool",
            "defaultValue": false
          }
        },
        "variables": {
          "offset": {
            "type": "String",
            "defaultValue": "0"
          },
          "nextOffset": {
            "type": "String",
            "defaultValue": "0"
          },
          "doLoad": {
            "type": "Boolean",
            "defaultValue": false
          }
        },
        "activities": [
          {
            "name": "Get load state",
            "type": "Lookup",
            "policy": {
              "timeout": "0.00:10:00",
              "retry": 2,
              "retryIntervalInSeconds": 60
            },
            "typeProperties": {
              "firstRowOnly": true,
              "dataset": {
                "referenceName": "DS_SqlTable",
                "type": "DatasetReference",
                "parameters": {
                  "schemaName": "gov",
                  "tableName": "source_state"
                }
              },
              "source": {
                "type": "AzureSqlSource",
                "queryTimeout": "00:05:00",
                "sqlReaderQuery": {
                  "value": "@concat('SELECT COALESCE(CONVERT(varchar(23), watermark, 126), ''1900-01-01T00:00:00'') AS watermark FROM gov.source_state WHERE source = ''', pipeline().parameters.source.name, '''')",
                  "type": "Expression"
                }
              }
            }
          },
          {
            "name": "Get source delta",
            "type": "Lookup",
            "policy": {
              "timeout": "0.00:05:00",
              "retry": 2,
              "retryIntervalInSeconds": 60
            },
            "dependsOn": [
              {
                "activity": "Get load state",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "typeProperties": {
              "firstRowOnly": true,
              "dataset": {
                "referenceName": "DS_SocrataJson",
                "type": "DatasetReference",
                "parameters": {
                  "baseUrl": "@pipeline().parameters.source.baseUrl",
                  "relativeUrl": {
                    "value": "@concat('resource/', pipeline().parameters.source.datasetId, '.json?$select=max(:updated_at),count(*)&$where=', concat(':updated_at>''', if(pipeline().parameters.fullReload, '1900-01-01T00:00:00', activity('Get load state').output.firstRow.watermark), ''''))",
                    "type": "Expression"
                  }
                }
              },
              "source": {
                "type": "RestSource",
                "requestMethod": "GET",
                "httpRequestTimeout": "00:02:00"
              }
            }
          },
          {
            "name": "Set doLoad",
            "type": "SetVariable",
            "dependsOn": [
              {
                "activity": "Get source delta",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "typeProperties": {
              "variableName": "doLoad",
              "value": {
                "value": "@greater(int(activity('Get source delta').output.firstRow.count), 0)",
                "type": "Expression"
              }
            }
          },
          {
            "name": "Copy pages",
            "type": "Until",
            "dependsOn": [
              {
                "activity": "Set doLoad",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "typeProperties": {
              "expression": {
                "value": "@or(not(variables('doLoad')), greaterOrEquals(int(variables('offset')), int(activity('Get source delta').output.firstRow.count)))",
                "type": "Expression"
              },
              "timeout": "0.03:00:00",
              "activities": [
                {
                  "name": "If loading",
                  "type": "IfCondition",
                  "typeProperties": {
                    "expression": {
                      "value": "@variables('doLoad')",
                      "type": "Expression"
                    },
                    "ifTrueActivities": [
                      {
                        "name": "Copy page to staging",
                        "type": "Copy",
                        "policy": {
                          "timeout": "0.00:30:00",
                          "retry": 2,
                          "retryIntervalInSeconds": 60
                        },
                        "inputs": [
                          {
                            "referenceName": "DS_SocrataJson",
                            "type": "DatasetReference",
                            "parameters": {
                              "baseUrl": "@pipeline().parameters.source.baseUrl",
                              "relativeUrl": {
                                "value": "@concat('resource/', pipeline().parameters.source.datasetId, '.json?$select=:*,*&$order=:id&$limit=50000&$offset=', variables('offset'), '&$where=', concat(':updated_at>''', if(pipeline().parameters.fullReload, '1900-01-01T00:00:00', activity('Get load state').output.firstRow.watermark), ''''))",
                                "type": "Expression"
                              }
                            }
                          }
                        ],
                        "outputs": [
                          {
                            "referenceName": "DS_SqlTable",
                            "type": "DatasetReference",
                            "parameters": {
                              "schemaName": "gov",
                              "tableName": {
                                "value": "@concat('stg_', pipeline().parameters.source.name)",
                                "type": "Expression"
                              }
                            }
                          }
                        ],
                        "typeProperties": {
                          "source": {
                            "type": "RestSource",
                            "requestMethod": "GET",
                            "httpRequestTimeout": "00:05:00"
                          },
                          "sink": {
                            "type": "AzureSqlSink",
                            "writeBatchSize": 10000,
                            "disableMetricsCollection": true,
                            "preCopyScript": {
                              "value": "@if(equals(variables('offset'), '0'), concat('TRUNCATE TABLE gov.stg_', pipeline().parameters.source.name), 'SELECT 1')",
                              "type": "Expression"
                            }
                          },
                          "enableStaging": false,
                          "dataIntegrationUnits": 2,
                          "translator": {
                            "value": "@pipeline().parameters.source.mapping",
                            "type": "Expression"
                          }
                        }
                      },
                      {
                        "name": "Next offset",
                        "type": "SetVariable",
                        "dependsOn": [
                          {
                            "activity": "Copy page to staging",
                            "dependencyConditions": [
                              "Succeeded"
                            ]
                          }
                        ],
                        "typeProperties": {
                          "variableName": "nextOffset",
                          "value": {
                            "value": "@string(add(int(variables('offset')), 50000))",
                            "type": "Expression"
                          }
                        }
                      },
                      {
                        "name": "Advance offset",
                        "type": "SetVariable",
                        "dependsOn": [
                          {
                            "activity": "Next offset",
                            "dependencyConditions": [
                              "Succeeded"
                            ]
                          }
                        ],
                        "typeProperties": {
                          "variableName": "offset",
                          "value": {
                            "value": "@variables('nextOffset')",
                            "type": "Expression"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "name": "If rows loaded",
            "type": "IfCondition",
            "dependsOn": [
              {
                "activity": "Copy pages",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "typeProperties": {
              "expression": {
                "value": "@variables('doLoad')",
                "type": "Expression"
              },
              "ifTrueActivities": [
                {
                  "name": "Merge into history",
                  "type": "SqlServerStoredProcedure",
                  "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 60
                  },
                  "linkedServiceName": {
                    "referenceName": "LS_AzureSql",
                    "type": "LinkedServiceReference"
                  },
                  "typeProperties": {
                    "storedProcedureName": {
                      "value": "@concat('gov.usp_merge_', pipeline().parameters.source.name)",
                      "type": "Expression"
                    },
                    "storedProcedureParameters": {
                      "published_epoch": {
                        "value": {
                          "value": "@div(sub(ticks(activity('Get source delta').output.firstRow.max_updated_at), ticks('1970-01-01T00:00:00Z')), 10000000)",
                          "type": "Expression"
                        },
                        "type": "Int64"
                      }
                    }
                  }
                }
              ]
            }
          }
        ],
        "annotations": [
          "mis281n",
          "procurement"
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('factoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('factoryName'), 'DS_SocrataJson')]",
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('factoryName'), 'DS_SqlTable')]",
        "[resourceId('Microsoft.DataFactory/factories/linkedservices', parameters('factoryName'), 'LS_AzureSql')]"
      ]
    },
